# OpenAI-compatible chat-completions endpoint
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=your-coding-model
LLM_API_KEY=replace-me

# Optional overrides
# LLM_AUTH_TYPE=bearer
# LLM_TIMEOUT_SEC=120
# LLM_MAX_TOKENS=4096
# 当前默认模型的部署窗口（需自行核对；配置后优先使用，不代表自动探测结果）
# 未配置时尝试查询服务端；查不到会显示未知，并按 128K 假设计算回退预算。
# CODING_CONTEXT_LENGTH=131072
# CODING_MAX_TURNS=30
# CONTEXT_SUMMARY_ENABLED=false
# MEMORY_ENABLED=true
