  "cards": [
    {
      "dot": "cyan",
      "title": "主链路:一次任务的旅程",
      "items": [
        "用户输入 → CLI 组装运行时 → 执行循环调模型",
        "模型要用工具改代码,工具结果回到模型继续推理",
        "Coding 的完成门检查修改验证;其他预设不启用该门"
      ]
    },
    {
      "dot": "emerald",
      "title": "数据落在哪",
      "items": [
        "会话 JSONL 只追加、不回改,压缩只影响运行时视图",
        "MEMORY.md 是模型用工具维护的跨会话精选记忆",
        "工作区文件是唯一被真实修改的代码"
      ]
    },
    {
      "dot": "violet",
      "title": "上下文怎么省",
      "items": [
        "每次调模型前按 token 预算组装消息,含工具定义开销",
        "自动用 BM25 从旧会话召回相关历史,临时注入不落盘",
        "原始细节仍保存在 JSONL;召回受范围与输出预算限制"
      ]
    },
    {
      "dot": "rose",
      "title": "一套内核,三种角色",
      "items": [
        "Engine 不认识 Coding/Review/Companion,只提供循环与契约",
        "Profile 决定注册哪些工具和指令,能力按角色裁剪",
        "review 不注册写工具,companion 不带文件和 Shell"
      ]
    }
  ]
